## Client and server lifecycle tests for tls (offline)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/str"
import "std/test"
import "../src/lib.alya" as tls

function main()
    test_suite("TLS Client/Server Tests")
    let r = runner_new()

    let cfg = tls::config("example.com")
    let mock = tls::tls_mock_establish(cfg)
    runner_assert_eq(r, mock.session.version, tls::TlsVersion.Tls12, "mock version")
    runner_assert_eq(r, mock.session.cipher_suite, 4865, "mock suite")
    runner_assert_eq(r, mock.sock, -1, "mock has no socket")

    let frames = tls::tls_wrap_app_data(mock, [72, 105])
    runner_assert_eq(r, len(frames), 1, "one app-data frame")
    runner_assert_eq(r, frames[0][0], 23, "frame is application_data")
    runner_assert_eq(r, len(frames[0]), 7, "frame 5 header + 2 payload")
    runner_assert_eq(r, tls::raw_send(-1, [1, 2]), -1, "raw send bad sock")
    runner_assert_eq(r, len(tls::raw_recv(-1, 100)), 0, "raw recv bad sock empty")
    let closed = tls::tls_context_new(cfg)
    runner_assert_eq(r, len(tls::tls_wrap_app_data(closed, [1])), 0, "no frames before establish")

    runner_assert_eq(r, tls::tls_send(closed, "hi"), -1, "send without socket is -1")
    runner_assert_str_eq(r, tls::tls_recv(closed), "", "recv without socket empty")
    runner_assert_eq(r, tls::tls_close(closed), 0, "close idempotent")

    let wire = tls::https_request_wire("example.com", "/api")
    runner_assert_true(r, index_of(wire, "GET /api HTTP/1.1") == 0, "request line")
    runner_assert_true(r, index_of(wire, "Host: example.com") > 0, "host header")

    let refused = tls::tls_client_config("127.0.0.1", 1, tls::TlsVerifyMode.None)
    let ctx = tls::connect(refused)
    runner_assert_eq(r, ctx.is_ok(), 0, "refused connection reports error")
    runner_assert_eq(r, ctx.state, tls::TlsState.Failed, "refused state failed")
    runner_assert_true(r, len(ctx.last_error) > 0, "refused error message set")
    tls::close(ctx)

    @cfg(feature = "server")
    let srv = tls::server(18443, "127.0.0.1")
    @cfg(feature = "server")
    runner_assert_eq(r, srv.port, 18443, "server port")
    @cfg(feature = "server")
    runner_assert_eq(r, srv.running, 0, "server stopped initially")
    @cfg(feature = "server")
    runner_assert_eq(r, tls::tls_server_has_identity(srv), 0, "no identity initially")
    @cfg(feature = "server")
    tls::tls_server_enable_tls(srv, "CERT", "KEY", 0)
    @cfg(feature = "server")
    runner_assert_eq(r, tls::tls_server_has_identity(srv), 1, "identity attached")
    @cfg(feature = "server")
    srv.running = 1
    @cfg(feature = "server")
    runner_assert_eq(r, srv.running, 1, "server running flag")
    @cfg(feature = "server")
    tls::tls_server_close(srv)
    @cfg(feature = "server")
    runner_assert_eq(r, srv.running, 0, "server stopped after close")

    @cfg(feature = "server")
    tls::tls_server_set_ciphers(srv, [4867])
    @cfg(feature = "server")
    tls::tls_server_set_alpn(srv, ["h2"])
    @cfg(feature = "server")
    let nego = tls::tls_server_negotiate(srv, [156, 4867], ["http/1.1", "h2"])
    @cfg(feature = "server")
    runner_assert_str_eq(r, nego["error"], "", "negotiation clean")
    @cfg(feature = "server")
    runner_assert_eq(r, nego["suite"], 4867, "server allowlist filters to chacha")
    @cfg(feature = "server")
    runner_assert_str_eq(r, nego["alpn"], "h2", "server alpn preferred")
    @cfg(feature = "server")
    let no_overlap = tls::tls_server_negotiate(srv, [156], ["h2"])
    @cfg(feature = "server")
    runner_assert_eq(r, no_overlap["suite"], 0, "no overlap suite zero")
    @cfg(feature = "server")
    runner_assert_true(r, no_overlap["error"] != "", "no overlap reports error")

    let vcert = tls::tls_cert_empty()
    vcert.subject_cn = "example.com"
    vcert.san = ["example.com"]
    vcert.not_before = "20230101000000Z"
    vcert.not_after = "20300101000000Z"
    vcert.fingerprint_sha256 = "abcd"
    let vctx = tls::tls_mock_establish(tls::config("example.com"))
    let verdict = tls::tls_verify_session(vctx, vcert, "20260101000000Z", "")
    runner_assert_eq(r, verdict["ok"], 1, "session verification passes")
    runner_assert_str_eq(r, vctx.session.peer_fingerprint, "abcd", "fingerprint recorded")
    let badctx = tls::tls_mock_establish(tls::config("example.com"))
    let badverdict = tls::tls_verify_session(badctx, vcert, "20310101000000Z", "")
    runner_assert_eq(r, badverdict["ok"], 0, "expired peer fails required")
    runner_assert_eq(r, badctx.state, tls::TlsState.Failed, "failed context state")
    let nocert = tls::tls_mock_establish(tls::config("example.com"))
    runner_assert_eq(r, tls::tls_verify_session(nocert, null)["ok"], 0, "missing cert fails required")

    @cfg(feature = "server")
    let mtls = tls::server(18444, "127.0.0.1")
    @cfg(feature = "server")
    tls::tls_server_enable_tls(mtls, "CERT", "KEY", 1)
    @cfg(feature = "server")
    let mctx = tls::tls_context_new(tls::config("client.example"))
    @cfg(feature = "server")
    let mverdict = tls::tls_server_verify_client(mtls, mctx, null)
    @cfg(feature = "server")
    runner_assert_eq(r, mverdict["ok"], 0, "mtls rejects missing client cert")
    @cfg(feature = "server")
    runner_assert_eq(r, mctx.state, tls::TlsState.Failed, "mtls failure recorded")

    # Chain auto-read with no live peer: Required fails closed, Optional passes through
    let req_ctx = tls::tls_mock_establish(tls::config("example.com"))
    let req_out = tls::tls_read_peer_chain(req_ctx)
    runner_assert_eq(r, req_out.state, tls::TlsState.Failed, "required without peer cert fails")
    let opt_ctx = tls::tls_mock_establish(tls::insecure_config("example.com"))
    let opt_out = tls::tls_read_peer_chain(opt_ctx)
    runner_assert_eq(r, opt_out.state, tls::TlsState.Established, "optional without peer cert passes")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()

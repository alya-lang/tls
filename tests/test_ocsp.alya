## Test suite for OCSP response parsing and validation.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as tls
import "crypto" as crypto

function ocsp_der() -> array
    return crypto::hex_to_bytes("")
end

function ocsp_ca_der() -> array
    return crypto::hex_to_bytes("")
end

function ocsp_leaf_der() -> array
    return crypto::hex_to_bytes("")
end

function main()
    test_suite("OCSP Tests")
    let r = runner_new()

    # 1. Response parses with good status.
    let p = tls::ocsp_parse_response(ocsp_der())
    runner_assert_str_eq(r, p["error"], "", "ocsp parses")
    runner_assert_eq(r, p["status"], 0, "response successful")
    runner_assert_eq(r, p["single"] is null, 0, "single present")
    runner_assert_str_eq(r, p["single"]["cert_status"], "good", "cert status good")
    runner_assert_true(r, len(p["tbs"]) > 0, "tbs present")
    runner_assert_true(r, len(p["single"]["this_update"]) > 0, "thisUpdate present")

    # 2. Full validation against the leaf/issuer pair (ECDSA requires 64-bit ints in crypto).
    let v = tls::ocsp_validate_for_cert(ocsp_der(), ocsp_leaf_der(), ocsp_ca_der(), "")
    runner_assert_str_eq(r, v["status"], "good", "validation status good")
    if target_arch() != "x86"
        runner_assert_eq(r, v["verified"], 1, "validation verified")
    end

    # 3. Wrong leaf serial fails closed.
    let v2 = tls::ocsp_validate_for_cert(ocsp_der(), ocsp_ca_der(), ocsp_ca_der(), "")
    runner_assert_eq(r, v2["verified"], 0, "serial mismatch fails")

    # 4. Garbage input fails closed.
    let v3 = tls::ocsp_validate_for_cert([48, 1, 2], ocsp_leaf_der(), ocsp_ca_der(), "")
    runner_assert_eq(r, v3["verified"], 0, "garbage fails")

    # 5. status_request extension shape.
    let sreq = tls::status_request_extension()
    runner_assert_eq(r, len(sreq), 9, "status_request length")
    runner_assert_eq(r, sreq[0] * 256 + sreq[1], 5, "status_request type")
    runner_assert_eq(r, sreq[4], 1, "status_request ocsp kind")

    # 6. ClientHello carries status_request; parser flags it.
    let cfg = tls::config("example.com")
    let hello = tls::build_client_hello(cfg)
    let hrt = tls::parse_client_hello(hello["body"])
    runner_assert_str_eq(r, hrt["error"], "", "own hello parses")
    runner_assert_eq(r, hrt["ocsp"], 1, "own hello requests ocsp")

    # 7. CertificateStatus build/parse roundtrip.
    let csb = tls::cert_status_build_body(ocsp_der())
    runner_assert_true(r, len(csb) > 0, "cert status builds")
    let csp = tls::cert_status_parse_body(csb)
    runner_assert_str_eq(r, csp["error"], "", "cert status parses")
    runner_assert_str_eq(r, crypto::bytes_to_hex(csp["resp"]), crypto::bytes_to_hex(ocsp_der()), "stapled bytes survive")
    runner_assert_eq(r, tls::cert_status_parse_body([22, 1])["error"] != "", 1, "short status rejected")

    # 8. Server stapling toggle stores the response.
    @cfg(feature = "server")
    let srv = tls::server(18444, "127.0.0.1")
    @cfg(feature = "server")
    tls::tls_server_enable_ocsp(srv, ocsp_der())
    @cfg(feature = "server")
    runner_assert_eq(r, len(srv.ocsp_response), len(ocsp_der()), "stapled response stored")

    # 9. ServerHello echoes status_request when stapling.
    let sh_plain = tls::build_server_hello(771, 156, null, "", 0)
    let sh_staple = tls::build_server_hello(771, 156, null, "", 1)
    runner_assert_true(r, len(sh_staple["body"]) > len(sh_plain["body"]), "staple flag grows hello")
    let shb = sh_staple["body"]
    let found_ext = 0
    let si = 0
    while si + 4 <= len(shb)
        if shb[si] == 0 and shb[si + 1] == 5 and shb[si + 2] == 0 and shb[si + 3] == 0
            found_ext = 1
        end
        si += 1
    end
    runner_assert_eq(r, found_ext, 1, "staple echo present")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()

## Facade smoke tests for tls
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as tls

function main()
    test_suite("TLS Facade Tests")
    let r = runner_new()

    runner_assert_str_eq(r, tls::version(), "0.1.0", "package version is 0.1.0")

    let cfg = tls::config("example.com")
    runner_assert_str_eq(r, cfg.host, "example.com", "config host set")
    runner_assert_eq(r, cfg.port, 443, "config default port 443")
    runner_assert_eq(r, cfg.verify_mode, tls::TlsVerifyMode.Required, "secure default requires verification")
    runner_assert_eq(r, cfg.is_valid(), 1, "default config is valid")

    let dev = tls::insecure_config("localhost", 8443)
    runner_assert_eq(r, dev.verify_mode, tls::TlsVerifyMode.None, "insecure config skips verification")
    runner_assert_eq(r, dev.port, 8443, "custom port kept")

    let moved = cfg.with_host("example.org")
    runner_assert_str_eq(r, moved.sni, "example.org", "with_host follows SNI")
    runner_assert_str_eq(r, cfg.host, "example.com", "original config immutable")

    runner_assert_eq(r, tls::native_version_code(3, 3), 771, "native version code 3.3 == 771")
    runner_assert_eq(r, tls::secure_compare("pin-abc", "pin-abc"), 1, "secure_compare equal strings")
    runner_assert_eq(r, tls::secure_compare("pin-abc", "pin-abd"), 0, "secure_compare different strings")

    let ctx = tls::tls_mock_establish(cfg)
    runner_assert_eq(r, ctx.state, tls::TlsState.Established, "mock session establishes")
    runner_assert_eq(r, ctx.session.is_established(), 1, "session reports established")
    let summary = tls::session_summary(ctx.session)
    runner_assert_true(r, len(summary) > 0, "session summary non-empty")

    let fallback = tls::config("")
    runner_assert_str_eq(r, fallback.host, "localhost", "empty host falls back to localhost")

    let bad_port = tls::config("example.com", 0)
    runner_assert_eq(r, bad_port.port, 443, "non-positive port falls back to 443")

    let inverted = tls::config("example.com")
    inverted.min_version = tls::TlsVersion.Tls13
    inverted.max_version = tls::TlsVersion.Tls12
    runner_assert_eq(r, inverted.is_valid(), 0, "inverted version bounds are invalid")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()

function leaf_pem_fixture() -> string
    return "-----BEGIN CERTIFICATE-----\nMIIDFDCCAfygAwIBAgIUbpcF/6wifnCjm5xm0Gji4/3tx5UwDQYJKoZIhvcNAQEL\nBQAwFDESMBAGA1UEAwwJdGVzdC1yb290MB4XDTI2MDkyNjIxMzQwNFoXDTI2MDky\nODIxMzQwNFowFzEVMBMGA1UEAwwMbGVhZi5leGFtcGxlMIIBIjANBgkqhkiG9w0B\nAQEFAAOCAQ8AMIIBCgKCAQEArrjVQYm14uuYCV096pRtV7FQZGbnAGhGoUx7tRpR\niyW/i5ZK0Ib1mx244O/Z7x93k6GYpRyeThtck1Kpr4ObSthO451yDR+eTE7BbVsF\nlBYqDsE+pI9nhqAc5owrIYjz5NtdFLHYnMJ+bAXrTZ68agrqaKyBJ+m2FgEhNlGm\nv0B4J0v/4XRkxImoQrkAbWE8hzbNU0n+VgoYY/6hKiq+50M2/cMffkDoPrmLe0Y0\n1dkXuK4Nr2Ld+lPhIcsqgTUvhFo0I3rXgNG6Hla2k9SjM2OL1yFOx3qtqzj8xd8q\nXhHcdfhNEzpju7vZhfm2ejhP+OZcTx9yinZ/IUV61MpEJwIDAQABo1swWTAXBgNV\nHREEEDAOggxsZWFmLmV4YW1wbGUwHQYDVR0OBBYEFAoSNfXundhPl3cnE1+CB1k7\n23jsMB8GA1UdIwQYMBaAFIIPfj/nd7dGy9GAYARJ0ibTXoXmMA0GCSqGSIb3DQEB\nCwUAA4IBAQCUN6sviIXyYpTiPRwZD3eRhAyeyrM3Yeb0GhQZ5Mnl8ngE+HsoIinU\nZCZxVJsuR55riTK851/mYq1idIGOEQIIDMkFsHSx1lJ8/jlhilH+bJvX/ntgOjQy\nnabItq0+rIDXhH9sV4kuyY3WpRskrjghHWZXXQ4CplRmvh5PYgDeQkAWny010kzo\nl/rwyEhJtGPTP3PKxW7Y4/SSEN7sYpgcJxaw+H3JM6vOeTNWrUpRotT0o0HYnu0t\na9Z4R2SNdKAxT0Acl7oHUhz0dsscQzghPW6aihbtTKF+ai7cYdR60XQqkffk68ky\nvq0mJdM+DnQHJ0ER3GXGAAPKrmCOb7uD\n-----END CERTIFICATE-----\n"
end

function cert_fixture()
    let c = tls::tls_cert_empty()
    c.subject = "CN=example"
    c.issuer = "CN=Test"
    c.subject_cn = "example"
    c.issuer_cn = "Test"
    c.san = ["example.com", "*.example.org"]
    c.serial_hex = "2a"
    c.not_before = "20230101000000Z"
    c.not_after = "20250101000000Z"
    c.fingerprint_sha256 = "abcd1234"
    c.der_len = 64
    return c
end

function main()
    test_suite("TLS Verify Tests")
    let r = runner_new()

    runner_assert_eq(r, tls::dns_pattern_matches("example.com", "example.com"), 1, "exact match")
    runner_assert_eq(r, tls::dns_pattern_matches("Example.COM", "example.com"), 1, "case-insensitive")
    runner_assert_eq(r, tls::dns_pattern_matches("*.example.org", "api.example.org"), 1, "wildcard single label")
    runner_assert_eq(r, tls::dns_pattern_matches("*.example.org", "a.b.example.org"), 0, "wildcard no multi-level")
    runner_assert_eq(r, tls::dns_pattern_matches("*.example.org", "example.org"), 0, "wildcard needs label")
    runner_assert_eq(r, tls::dns_pattern_matches("f*o.example.org", "foo.example.org"), 0, "partial wildcard rejected")
    runner_assert_eq(r, tls::dns_pattern_matches("", "example.com"), 0, "empty pattern safe")

    let cert = cert_fixture()
    runner_assert_eq(r, tls::verify_hostname(cert, "example.com"), 1, "san exact verifies")
    runner_assert_eq(r, tls::verify_hostname(cert, "api.example.org"), 1, "san wildcard verifies")
    runner_assert_eq(r, tls::verify_hostname(cert, "other.com"), 0, "unknown host fails")

    let cn_only = tls::tls_cert_empty()
    cn_only.subject_cn = "solo.example"
    runner_assert_eq(r, tls::verify_hostname(cn_only, "solo.example"), 1, "cn fallback verifies")
    runner_assert_eq(r, tls::verify_hostname(cn_only, "x.example"), 0, "cn fallback mismatch")

    runner_assert_eq(r, tls::verify_cert_time(cert, "20240101000000Z"), 1, "inside window")
    runner_assert_eq(r, tls::verify_cert_time(cert, "20260101000000Z"), 0, "after window")
    runner_assert_eq(r, tls::verify_cert_time(cert, "20220101000000Z"), 0, "before window")
    runner_assert_eq(r, tls::verify_cert_time(cert, ""), 1, "empty stamp skips")

    runner_assert_eq(r, tls::verify_fingerprint(cert, "AB:CD:12:34"), 1, "pin format-insensitive")
    runner_assert_eq(r, tls::verify_fingerprint(cert, "ffff"), 0, "wrong pin fails")

    let ok = tls::verify_peer(cert, "example.com", tls::TlsVerifyMode.Required, "20240101000000Z", "abcd1234")
    runner_assert_eq(r, ok["ok"], 1, "full verification passes")
    let bad_host = tls::verify_peer(cert, "evil.com", tls::TlsVerifyMode.Required, "20240101000000Z", "")
    runner_assert_eq(r, bad_host["ok"], 0, "wrong host fails required")
    let off = tls::verify_peer(cert, "evil.com", tls::TlsVerifyMode.None, "", "")
    runner_assert_eq(r, off["ok"], 1, "disabled mode passes")

    runner_assert_eq(r, tls::cert_name_eq("CN=Test", "CN=Test"), 1, "name eq match")
    runner_assert_eq(r, tls::cert_name_eq("CN=A", "CN=B"), 0, "name eq mismatch")
    runner_assert_eq(r, tls::cert_name_eq("", ""), 0, "empty names never match")

    let leaf = tls::tls_cert_empty()
    leaf.subject = "CN=example.com"
    leaf.subject_cn = "example.com"
    leaf.issuer = "CN=Test CA"
    leaf.issuer_cn = "Test CA"
    leaf.not_before = "20230101000000Z"
    leaf.not_after = "20300101000000Z"
    let root = tls::tls_cert_empty()
    root.subject = "CN=Test CA"
    root.subject_cn = "Test CA"
    root.issuer = "CN=Test CA"
    root.issuer_cn = "Test CA"
    root.not_before = "20230101000000Z"
    root.not_after = "20300101000000Z"
    runner_assert_eq(r, tls::chain_link_ok(leaf, root), 1, "leaf links to root")
    runner_assert_eq(r, tls::chain_link_ok(root, leaf), 0, "reversed link fails")
    let linked = tls::chain_verify_linkage([leaf, root], "20260101000000Z")
    runner_assert_eq(r, linked["ok"], 1, "ordered chain links")
    runner_assert_eq(r, linked["length"], 2, "chain length reported")
    let broken = tls::chain_verify_linkage([root, leaf], "20260101000000Z")
    runner_assert_eq(r, broken["ok"], 0, "misordered chain fails")
    let stale = tls::chain_verify_linkage([leaf, root], "20310101000000Z")
    runner_assert_eq(r, stale["ok"], 0, "expired chain fails")
    runner_assert_eq(r, tls::chain_verify_linkage([], "")["ok"], 0, "empty chain fails")

    # ── Full signature chain (openssl 2-level CA) ──
    let ca = tls::parse_certificate_pem(ca_pem_fixture())
    let leaf = tls::parse_certificate_pem(leaf_pem_fixture())
    runner_assert_eq(r, len(ca.der) > 0, 1, "ca der retained")
    runner_assert_eq(r, len(leaf.der) > 0, 1, "leaf der retained")
    let sigs = tls::chain_verify_signatures([leaf, ca])
    runner_assert_eq(r, sigs["ok"], 1, "chain signatures verify")
    runner_assert_eq(r, sigs["checked"], 2, "both certs checked")
    let full = tls::chain_verify_full([leaf, ca], "leaf.example", "", "")
    runner_assert_eq(r, full["ok"], 1, "full chain verification passes")
    let wrong_host = tls::chain_verify_full([leaf, ca], "evil.com", "", "")
    runner_assert_eq(r, wrong_host["ok"], 0, "full verification enforces hostname")

    let advisory = tls::verify_peer(cert, "evil.com", tls::TlsVerifyMode.Optional, "20240101000000Z", "")
    runner_assert_eq(r, advisory["ok"], 1, "optional stays advisory on mismatch")
    runner_assert_eq(r, advisory["host_ok"], 0, "optional still reports host mismatch")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()

## Example usage and walkthrough for tls
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as tls

function main()
    say "=== tls Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Configurations
    # ───────────────────────────────────────────────────────────
    say "--- 1. Configurations ---"
    let cfg = tls::config("example.com")
    say "Host:          " + cfg.host
    say "Port:          " + str(cfg.port)
    say "SNI:           " + cfg.sni
    say "Min version:   " + tls::version_to_string(cfg.min_version)
    say "Max version:   " + tls::version_to_string(cfg.max_version)
    say "Valid:         " + str(cfg.is_valid())
    let dev = tls::insecure_config("localhost", 8443)
    say "Dev verify:    " + str(dev.verify_mode) + " (0 = disabled)"
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Cipher suites
    # ───────────────────────────────────────────────────────────
    say "--- 2. Cipher Suites ---"
    let suites = tls::cipher_default_suites()
    say "Defaults:      " + str(len(suites)) + " suites"
    say "First:         " + tls::cipher_suite_name(suites[0])
    let picked = tls::cipher_select([156, 4867], [156, 4867])
    say "Negotiated:    " + tls::cipher_suite_name(picked)
    say "AEAD:          " + str(tls::cipher_is_aead(picked))
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Record layer
    # ───────────────────────────────────────────────────────────
    say "--- 3. Record Layer ---"
    let rec = tls::record_encode(tls::TlsContentType.Handshake, tls::TlsVersion.Tls12, [1, 2, 3])
    say "Type:          " + tls::record_type_name(rec["type"])
    say "Length:        " + str(rec["length"])
    let back = tls::record_decode(rec["bytes"])
    say "Roundtrip err: '" + back["error"] + "'"
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. ClientHello with SNI/ALPN
    # ───────────────────────────────────────────────────────────
    say "--- 4. ClientHello ---"
    let hello = tls::build_client_hello(cfg)
    say "Offered:       " + tls::version_to_string(hello["version"])
    say "SNI on wire:   " + tls::client_hello_sni(hello["body"])
    say "Record bytes:  " + str(len(hello["bytes"]))
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. Key schedule
    # ───────────────────────────────────────────────────────────
    say "--- 5. Key Schedule ---"
    let rnd = tls::hello_random()
    say "Random bytes:  " + str(len(rnd))
    let ms = tls::master_secret(rnd, rnd, rnd)
    say "Master secret: " + str(len(ms)) + " bytes"
    let kb = tls::key_block(ms, rnd, rnd, 40)
    say "Key block:     " + str(len(kb)) + " bytes"
    let tx = tls::transcript_hash(hello["body"])
    let fin = tls::finished_verify_data(ms, "client finished", tx)
    say "Verify data:   " + str(len(fin)) + " bytes"
    say ""

    # ───────────────────────────────────────────────────────────
    # 6. Certificates and verification
    # ───────────────────────────────────────────────────────────
    say "--- 6. Certificates ---"
    let cert = tls::tls_cert_empty()
    cert.subject_cn = "example.com"
    cert.san = ["example.com", "*.example.org"]
    cert.not_before = "20230101000000Z"
    cert.not_after = "20300101000000Z"
    say "SAN host:      " + str(tls::verify_hostname(cert, "api.example.org"))
    let verdict = tls::verify_peer(cert, "example.com", tls::TlsVerifyMode.Required, "20260101000000Z", "")
    say "Peer verdict:  " + str(verdict["ok"]) + " (" + verdict["detail"] + ")"
    say ""

    # ───────────────────────────────────────────────────────────
    # 7. Mock session and server handle
    # ───────────────────────────────────────────────────────────
    say "--- 7. Session & Server ---"
    let sess = tls::tls_mock_establish(cfg)
    say "Session:       " + tls::session_summary(sess.session)
    let frames = tls::tls_wrap_app_data(sess, [72, 105])
    say "App frames:    " + str(len(frames))
    let srv = tls::server(8443)
    tls::tls_server_enable_tls(srv, "CERT", "KEY", 0)
    say "Server ident:  " + str(tls::tls_server_has_identity(srv))
    tls::tls_server_close(srv)
    say ""

    # ───────────────────────────────────────────────────────────
    # 8. Native helpers
    # ───────────────────────────────────────────────────────────
    say "--- 8. Native Helpers ---"
    say "Compare equal: " + str(tls::secure_compare("pin", "pin"))
    say "Version code:  " + str(tls::native_version_code(3, 4))
    say ""
    say "Done!"
end

main()

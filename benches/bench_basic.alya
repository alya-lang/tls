## Benchmark suite for tls
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as tls

function main()
    let runner = bench_runner("tls Micro-Benchmarks")

    # Bench 1: version negotiation — 200k iterations
    bench_start(runner, 200000)
    let i = 0
    while i < 200000
        tls::version_negotiate(tls::TlsVersion.Tls12, tls::TlsVersion.Tls13, tls::TlsVersion.Tls12)
        i += 1
    end
    bench_stop(runner, "version_negotiate() 200k calls")

    # Bench 2: cipher selection — 100k iterations
    let offered = [156, 4865, 4867]
    bench_start(runner, 100000)
    let j = 0
    while j < 100000
        tls::cipher_select(offered, offered)
        j += 1
    end
    bench_stop(runner, "cipher_select() 100k calls")

    # Bench 3: record encode + decode — 100k iterations
    let frag = [1, 2, 3, 4, 5, 6, 7, 8]
    bench_start(runner, 100000)
    let k = 0
    while k < 100000
        let rec = tls::record_encode(tls::TlsContentType.ApplicationData, tls::TlsVersion.Tls12, frag)
        tls::record_decode(rec["bytes"])
        k += 1
    end
    bench_stop(runner, "record roundtrip 100k calls")

    # Bench 4: ClientHello build — 10k iterations
    let cfg = tls::config("example.com")
    bench_start(runner, 10000)
    let m = 0
    while m < 10000
        tls::build_client_hello(cfg)
        m += 1
    end
    bench_stop(runner, "build_client_hello() 10k calls")

    # Bench 5: hostname verification — 100k iterations
    bench_start(runner, 100000)
    let n = 0
    while n < 100000
        tls::dns_pattern_matches("*.example.org", "api.example.org")
        n += 1
    end
    bench_stop(runner, "dns_pattern_matches() 100k calls")

    # Bench 6: native constant-time compare — 200k iterations
    bench_start(runner, 200000)
    let c = 0
    while c < 200000
        tls::secure_compare("9ffcbaffd6fa6ede", "9ffcbaffd6fa6ede")
        c += 1
    end
    bench_stop(runner, "secure_compare() 200k calls")

    # Bench 7: PRF-32 — 2k iterations (crypto-heavy)
    let sec = [11, 22, 33]
    let sd = [1, 2, 3, 4]
    bench_start(runner, 2000)
    let p = 0
    while p < 2000
        tls::prf_sha256(sec, "bench", sd, 32)
        p += 1
    end
    bench_stop(runner, "prf_sha256() 32B 2k calls")

    # Bench 8: server negotiation — 50k iterations
    let allow = tls::cipher_default_suites()
    bench_start(runner, 50000)
    let q = 0
    while q < 50000
        tls::cipher_select(allow, allow)
        tls::alpn_select(["h2", "http/1.1"], ["http/1.1"])
        q += 1
    end
    bench_stop(runner, "negotiate suite+alpn 50k calls")

    # Bench 9: alert record build — 200k iterations
    bench_start(runner, 200000)
    let t = 0
    while t < 200000
        tls::tls_alert_bytes(tls::TlsAlertLevel.Warning, tls::TlsAlertDescription.CloseNotify, tls::TlsVersion.Tls12)
        t += 1
    end
    bench_stop(runner, "tls_alert_bytes() 200k calls")

    bench_summary(runner)
end

main()

## TLS handshake message builders and parsers.
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Produces structurally valid ClientHello bytes (with SNI/ALPN extensions),
## parses ServerHello responses, and derives Finished verification data.
## Bulk key derivation lives in `core/keys.alya`.

import "crypto" as crypto
import "../types.alya"
import "./version.alya"
import "./cipher.alya"
import "./record.alya"
import "./keys.alya"

## Generates a 32-byte client random value.
##
## ### Returns
## Array of 32 byte integers from the cryptographic RNG.
pub function hello_random() -> array
    return crypto::random_bytes(32)
end

## Builds the Server Name Indication extension for a hostname.
##
## ### Parameters
## - `hostname`: DNS name for the `server_name` entry.
##
## ### Returns
## Extension byte array (type `0x0000` with length prefix).
pub function sni_extension(hostname: string) -> array
    let host = hostname
    if host is null
        host = ""
    end
    let name_bytes = []
    let i = 0
    while i < len(host)
        name_bytes.push(ord(char_at(host, i)))
        i += 1
    end
    let entry = [0]
    let nl = u16_to_bytes(len(name_bytes))
    entry.push(nl[0])
    entry.push(nl[1])
    let k = 0
    while k < len(name_bytes)
        entry.push(name_bytes[k])
        k += 1
    end
    let list_len = u16_to_bytes(len(entry))
    let data = [list_len[0], list_len[1]]
    let m = 0
    while m < len(entry)
        data.push(entry[m])
        m += 1
    end
    let ext_len = u16_to_bytes(len(data))
    let ext = [0, 0, ext_len[0], ext_len[1]]
    let n = 0
    while n < len(data)
        ext.push(data[n])
        n += 1
    end
    return ext
end

## Builds the ALPN extension advertising protocol preferences.
##
## ### Parameters
## - `protocols`: Protocol name array (e.g. `["h2", "http/1.1"]`).
##
## ### Returns
## Extension byte array (type `0x0010`), or empty array for no input.
pub function alpn_extension(protocols) -> array
    if protocols is null or len(protocols) == 0
        return []
    end
    let names = []
    let p = 0
    while p < len(protocols)
        let proto = protocols[p]
        if proto is not null and len(proto) > 0 and len(proto) < 256
            names.push(len(proto))
            let q = 0
            while q < len(proto)
                names.push(ord(char_at(proto, q)))
                q += 1
            end
        end
        p += 1
    end
    if len(names) == 0
        return []
    end
    let list_len = u16_to_bytes(len(names))
    let data = [list_len[0], list_len[1]]
    let m = 0
    while m < len(names)
        data.push(names[m])
        m += 1
    end
    let ext_len = u16_to_bytes(len(data))
    let ext = [0, 16, ext_len[0], ext_len[1]]
    let n = 0
    while n < len(data)
        ext.push(data[n])
        n += 1
    end
    return ext
end

## Builds the status_request extension for OCSP stapling (RFC 6066).
##
## Requests a stapled OCSP response with an empty responder list:
## `status_type(ocsp) + responder_id_list_len(0) + request_ext_len(0)`.
##
## ### Returns
## Extension byte array (type `0x0005`).
pub function status_request_extension() -> array
    return [0, 5, 0, 5, 1, 0, 0, 0, 0]
end

## Builds the signature_algorithms extension (RFC 8446 section 4.2.3).
##
## Offers only schemes this package verifies: ECDSA secp256r1 + RSA
## PKCS#1 v1.5 with SHA-256/384. PSS and P-384 stay unadvertised until
## their verifiers land, so peers never select an unverifiable scheme.
##
## ### Returns
## Extension byte array (type `0x000d`).
pub function sigalgs_extension() -> array
    let schemes = [1027, 1025, 1281]
    let data = u16_to_bytes(len(schemes) * 2)
    let s = 0
    while s < len(schemes)
        let sb = u16_to_bytes(schemes[s])
        data.push(sb[0])
        data.push(sb[1])
        s += 1
    end
    let ext_len = u16_to_bytes(len(data))
    let ext = [0, 13, ext_len[0], ext_len[1]]
    let n = 0
    while n < len(data)
        ext.push(data[n])
        n += 1
    end
    return ext
end

## Builds the supported_groups extension (RFC 8446 section 4.2.7).
##
## Advertises secp256r1, secp384r1, and x25519 for ECDHE key exchange.
##
## ### Returns
## Extension byte array (type `0x000a`).
pub function groups_extension() -> array
    let groups = [23, 24, 29]
    let data = u16_to_bytes(len(groups) * 2)
    let g = 0
    while g < len(groups)
        let gb = u16_to_bytes(groups[g])
        data.push(gb[0])
        data.push(gb[1])
        g += 1
    end
    let ext_len = u16_to_bytes(len(data))
    let ext = [0, 10, ext_len[0], ext_len[1]]
    let n = 0
    while n < len(data)
        ext.push(data[n])
        n += 1
    end
    return ext
end

## Builds a complete ClientHello record for the given config.
##
## ### Parameters
## - `config`: Active `TlsConfig` snapshot.
## - `suites`: Cipher suite preference array (empty means defaults).
##
## ### Returns
## Map with `random`, `suites`, `sni`, `version`, record `bytes`, and
## handshake `body` bytes for transcript hashing.
pub function build_client_hello(config, suites = null) -> map
    let prefs = suites
    if prefs is null or len(prefs) == 0
        prefs = config.cipher_allowlist
    end
    if prefs is null or len(prefs) == 0
        prefs = cipher_default_suites()
    end
    let offered = TlsVersion.Tls12
    if version_compare(config.max_version, TlsVersion.Tls12) > 0
        offered = TlsVersion.Tls12
    elif version_compare(config.max_version, TlsVersion.Tls10) < 0
        offered = TlsVersion.Tls10
    else
        offered = config.max_version
    end
    let rnd = hello_random()
    let ver_bytes = u16_to_bytes(offered)
    let body = [ver_bytes[0], ver_bytes[1]]
    let r = 0
    while r < len(rnd)
        body.push(rnd[r])
        r += 1
    end
    body.push(0)
    let suite_len = u16_to_bytes(len(prefs) * 2)
    body.push(suite_len[0])
    body.push(suite_len[1])
    let s = 0
    while s < len(prefs)
        let sb = u16_to_bytes(prefs[s])
        body.push(sb[0])
        body.push(sb[1])
        s += 1
    end
    body.push(1)
    body.push(0)
    let exts = sni_extension(config.sni)
    let alpn = alpn_extension(config.alpn)
    let a = 0
    while a < len(alpn)
        exts.push(alpn[a])
        a += 1
    end
    let sigalgs = sigalgs_extension()
    let g = 0
    while g < len(sigalgs)
        exts.push(sigalgs[g])
        g += 1
    end
    let groups = groups_extension()
    g = 0
    while g < len(groups)
        exts.push(groups[g])
        g += 1
    end
    let ocsp_req = status_request_extension()
    let o = 0
    while o < len(ocsp_req)
        exts.push(ocsp_req[o])
        o += 1
    end
    let ext_len = u16_to_bytes(len(exts))
    body.push(ext_len[0])
    body.push(ext_len[1])
    let e = 0
    while e < len(exts)
        body.push(exts[e])
        e += 1
    end
    let hs_len = len(body)
    let hello = [TlsHandshakeType.ClientHello, bit_and(bit_shr(hs_len, 16), 255), bit_and(bit_shr(hs_len, 8), 255), bit_and(hs_len, 255)]
    let h = 0
    while h < len(body)
        hello.push(body[h])
        h += 1
    end
    let rec = record_encode(TlsContentType.Handshake, TlsVersion.Tls10, hello)
    return { "random": rnd, "suites": prefs, "sni": config.sni, "version": offered, "body": body, "bytes": rec["bytes"] }
end

## Parses a ServerHello body (without record/handshake headers).
##
## ### Parameters
## - `body`: ServerHello body byte array.
##
## ### Returns
## Map with `version`, `random`, `session_id`, `cipher_suite`, and `error`.
pub function parse_server_hello(body) -> map
    let fail = { "version": 0, "random": [], "session_id": "", "cipher_suite": 0, "error": "empty body" }
    if body is null or len(body) < 38
        return fail
    end
    let ver = body[0] * 256 + body[1]
    if version_is_supported(ver) == 0
        return { "version": 0, "random": [], "session_id": "", "cipher_suite": 0, "error": "unsupported server version" }
    end
    let rnd = []
    let i = 0
    while i < 32
        rnd.push(body[2 + i])
        i += 1
    end
    let sid_len = body[34]
    if len(body) < 35 + sid_len + 3
        return { "version": 0, "random": [], "session_id": "", "cipher_suite": 0, "error": "truncated server hello" }
    end
    let sid = []
    let k = 0
    while k < sid_len
        sid.push(body[35 + k])
        k += 1
    end
    let suite = body[35 + sid_len] * 256 + body[35 + sid_len + 1]
    return { "version": ver, "random": rnd, "session_id": crypto::bytes_to_hex(sid), "cipher_suite": suite, "error": "" }
end

## Extracts the SNI hostname embedded in a ClientHello body.
##
## Scans the extension block for a `server_name` entry of type host_name.
##
## ### Parameters
## - `body`: ClientHello body byte array.
##
## ### Returns
## Hostname string, or empty when absent/unparseable.
pub function client_hello_sni(body) -> string
    if body is null or len(body) < 40
        return ""
    end
    let sid_len = body[34]
    let pos = 35 + sid_len
    if len(body) < pos + 2
        return ""
    end
    let suite_len = body[pos] * 256 + body[pos + 1]
    pos = pos + 2 + suite_len + 1
    if len(body) < pos + 1
        return ""
    end
    pos = pos + 1 + body[pos]
    if len(body) < pos + 2
        return ""
    end
    let ext_total = body[pos] * 256 + body[pos + 1]
    pos = pos + 2
    let end_pos = pos + ext_total
    if end_pos > len(body)
        end_pos = len(body)
    end
    while pos + 4 <= end_pos
        let etype = body[pos] * 256 + body[pos + 1]
        let elen = body[pos + 2] * 256 + body[pos + 3]
        pos = pos + 4
        if pos + elen > end_pos
            break
        end
        if etype == 0 and elen >= 5
            let list_len = body[pos] * 256 + body[pos + 1]
            if list_len + 2 <= elen and body[pos + 2] == 0
                let name_len = body[pos + 3] * 256 + body[pos + 4]
                if 5 + name_len <= elen
                    let out = ""
                    let n = 0
                    while n < name_len
                        out = out + chr(body[pos + 5 + n])
                        n += 1
                    end
                    return out
                end
            end
        end
        pos = pos + elen
    end
    return ""
end

## Derives Finished verification data (TLS 1.2 PRF, first 12 bytes).
##
## Standard construction: `PRF(master, label, transcript_hash)[0..11]`
## with the SHA-256 P_hash. Verified against live servers.
##
## ### Parameters
## - `master_secret`: Master secret byte array.
## - `label`: ASCII label (`"client finished"` or `"server finished"`).
## - `transcript_hash`: Handshake transcript hash byte array.
##
## ### Returns
## 12-byte verification array.
pub function finished_verify_data(master_secret, label: string, transcript_hash) -> array
    let seed = []
    if transcript_hash is not null
        seed = transcript_hash
    end
    let out = prf_sha256(master_secret, label, seed, 12)
    let res = []
    let k = 0
    while k < 12 and k < len(out)
        res.push(out[k])
        k += 1
    end
    return res
end

## Hashes a handshake transcript with SHA-256.
##
## ### Parameters
## - `transcript`: Concatenated handshake byte array.
##
## ### Returns
## 32-byte digest array.
pub function transcript_hash(transcript) -> array
    let data = transcript
    if data is null
        data = []
    end
    return crypto::sha256_bytes(data)
end

## Selects the first server-preferred protocol the client also offers.
##
## Element comparison normalizes through concatenation: plain `==` on two
## array-derived strings mis-evaluates inside function scope (compiler
## issue, see `alpn_str_eq`), so both sides are rebuilt first.
##
## ### Parameters
## - `server_protos`: Server preference array (may be null).
## - `client_protos`: Client offer array (may be null).
##
## ### Returns
## Selected protocol string, or empty when there is no overlap.
pub function alpn_select(server_protos, client_protos) -> string
    if server_protos is null or client_protos is null
        return ""
    end
    let i = 0
    while i < len(server_protos)
        let cand = server_protos[i]
        let j = 0
        while j < len(client_protos)
            if alpn_str_eq(client_protos[j], cand) == 1
                return cand
            end
            j += 1
        end
        i += 1
    end
    return ""
end

# Compares two strings by value, normalizing array-derived operands.
function alpn_str_eq(a: string, b: string) -> int
    if (a + "") == (b + "")
        return 1
    end
    return 0
end

## Parses a ClientHello body (without record/handshake headers).
##
## Extracts version, random, session id, offered suites, SNI, and ALPN.
##
## ### Parameters
## - `body`: ClientHello body byte array.
##
## ### Returns
## Map with `version`, `random`, `session_id`, `suites`, `sni`, `alpn`,
## and `error` fields.
pub function parse_client_hello(body) -> map
    let fail = { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "empty body" }
    if body is null or len(body) < 38
        return fail
    end
    let ver = body[0] * 256 + body[1]
    if version_is_supported(ver) == 0
        return { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "unsupported client version" }
    end
    let rnd = slice_bytes(body, 2, 32)
    let pos = 34
    if pos >= len(body)
        return { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "truncated session id" }
    end
    let sid_len = body[pos]
    pos += 1
    if pos + sid_len > len(body)
        return { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "truncated session id" }
    end
    let sid = crypto::bytes_to_hex(slice_bytes(body, pos, sid_len))
    pos += sid_len
    if pos + 2 > len(body)
        return { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "truncated suites" }
    end
    let suite_len = body[pos] * 256 + body[pos + 1]
    pos += 2
    if pos + suite_len > len(body) or suite_len % 2 != 0
        return { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "truncated suites" }
    end
    let suites = []
    let s = 0
    while s < suite_len
        suites.push(body[pos + s] * 256 + body[pos + s + 1])
        s += 2
    end
    pos += suite_len
    if pos >= len(body)
        return { "version": ver, "random": rnd, "session_id": sid, "suites": suites, "sni": "", "alpn": [], "ocsp": 0, "error": "" }
    end
    let comp_len = body[pos]
    pos += 1
    if pos + comp_len > len(body)
        return { "version": 0, "random": [], "session_id": "", "suites": [], "sni": "", "alpn": [], "ocsp": 0, "error": "truncated compression" }
    end
    pos += comp_len
    if pos + 2 > len(body)
        return { "version": ver, "random": rnd, "session_id": sid, "suites": suites, "sni": "", "alpn": [], "ocsp": 0, "error": "" }
    end
    let ext_total = body[pos] * 256 + body[pos + 1]
    pos += 2
    let end_pos = pos + ext_total
    if end_pos > len(body)
        end_pos = len(body)
    end
    let sni = ""
    let alpn = []
    let ocsp = 0
    while pos + 4 <= end_pos
        let etype = body[pos] * 256 + body[pos + 1]
        let elen = body[pos + 2] * 256 + body[pos + 3]
        pos += 4
        if pos + elen > end_pos
            break
        end
        if etype == 0 and elen >= 5
            let list_len = body[pos] * 256 + body[pos + 1]
            if list_len + 2 <= elen and body[pos + 2] == 0
                let name_len = body[pos + 3] * 256 + body[pos + 4]
                if 5 + name_len <= elen
                    sni = ""
                    let n = 0
                    while n < name_len
                        sni = sni + chr(body[pos + 5 + n])
                        n += 1
                    end
                end
            end
        end
        if etype == 16 and elen >= 2
            let list_len = body[pos] * 256 + body[pos + 1]
            let q = pos + 2
            let qend = q + list_len
            if qend > pos + elen
                qend = pos + elen
            end
            while q < qend
                let plen = body[q]
                q += 1
                if plen > 0 and q + plen <= qend
                    let proto = ""
                    let r = 0
                    while r < plen
                        proto = proto + chr(body[q + r])
                        r += 1
                    end
                    alpn.push(proto)
                    q += plen
                else
                    break
                end
            end
        end
        if etype == 5 and elen >= 1 and body[pos] == 1
            ocsp = 1
        end
        pos += elen
    end
    return { "version": ver, "random": rnd, "session_id": sid, "suites": suites, "sni": sni, "alpn": alpn, "ocsp": ocsp, "error": "" }
end

## Builds a Certificate handshake message body from DER certificates.
##
## ### Parameters
## - `ders`: Array of DER byte arrays (chain order).
##
## ### Returns
## Message body bytes (3-byte total + repeated length + DER).
pub function build_certificate_body(ders) -> array
    let entries = []
    if ders is not null
        let i = 0
        while i < len(ders)
            let der = ders[i]
            if der is not null and len(der) > 0
                entries.push(bit_and(bit_shr(len(der), 16), 255))
                entries.push(bit_and(bit_shr(len(der), 8), 255))
                entries.push(bit_and(len(der), 255))
                let j = 0
                while j < len(der)
                    entries.push(der[j])
                    j += 1
                end
            end
            i += 1
        end
    end
    let out = [0, 0, 0]
    let n = len(entries)
    out[0] = bit_and(bit_shr(n, 16), 255)
    out[1] = bit_and(bit_shr(n, 8), 255)
    out[2] = bit_and(n, 255)
    let k = 0
    while k < len(entries)
        out.push(entries[k])
        k += 1
    end
    return out
end

## Builds a ServerHello record answering a ClientHello.
##
## Pairs with `parse_server_hello`: the produced body roundtrips through
## the parser, which server tests assert without network I/O.
##
## ### Parameters
## - `version`: Negotiated version code.
## - `cipher_suite`: Selected cipher suite id.
## - `random`: 32-byte server random (null generates a fresh one).
## - `session_id_hex`: Session id as hex string (empty means no session).
## - `staple_ocsp`: `1` echoes an empty status_request extension.
##
## ### Returns
## Map with `version`, `cipher_suite`, `random`, `session_id`, `body`,
## `bytes`, and `wire` fields.
pub function build_server_hello(version: int, cipher_suite: int, random = null, session_id_hex: string = "", staple_ocsp: int = 0) -> map
    let ver = version
    if version_is_supported(ver) == 0
        ver = TlsVersion.Tls12
    end
    let rnd = random
    if rnd is null or len(rnd) != 32
        rnd = hello_random()
    end
    let sid = []
    if session_id_hex is not null and session_id_hex != ""
        sid = crypto::hex_to_bytes(session_id_hex)
    end
    if len(sid) > 32
        sid = slice_bytes(sid, 0, 32)
    end
    let ver_bytes = u16_to_bytes(ver)
    let body = [ver_bytes[0], ver_bytes[1]]
    let r = 0
    while r < len(rnd)
        body.push(rnd[r])
        r += 1
    end
    body.push(len(sid))
    let k = 0
    while k < len(sid)
        body.push(sid[k])
        k += 1
    end
    let suite_bytes = u16_to_bytes(cipher_suite)
    body.push(suite_bytes[0])
    body.push(suite_bytes[1])
    body.push(0)
    let ri_ext = [255, 1, 0, 1, 0]
    if staple_ocsp == 1
        ri_ext.push(0)
        ri_ext.push(5)
        ri_ext.push(0)
        ri_ext.push(0)
    end
    let ext_total = u16_to_bytes(len(ri_ext))
    body.push(ext_total[0])
    body.push(ext_total[1])
    let x = 0
    while x < len(ri_ext)
        body.push(ri_ext[x])
        x += 1
    end
    let hs_len = len(body)
    let hello = [TlsHandshakeType.ServerHello, bit_and(bit_shr(hs_len, 16), 255), bit_and(bit_shr(hs_len, 8), 255), bit_and(hs_len, 255)]
    let h = 0
    while h < len(body)
        hello.push(body[h])
        h += 1
    end
    let rec = record_encode(TlsContentType.Handshake, TlsVersion.Tls10, hello)
    return { "version": ver, "cipher_suite": cipher_suite, "random": rnd, "session_id": crypto::bytes_to_hex(sid), "body": body, "bytes": rec["bytes"] }
end

## Copies `n` bytes starting at `offset` from a byte array.
##
## ### Parameters
## - `data`: Source byte array.
## - `offset`: Start position.
## - `n`: Number of bytes to copy.
##
## ### Returns
## Sliced byte array.
pub function slice_bytes(data, offset: int, n: int) -> array
    let part = []
    if data is null or n <= 0
        return part
    end
    let i = 0
    while i < n and offset + i < len(data)
        part.push(data[offset + i])
        i += 1
    end
    return part
end

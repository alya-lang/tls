## Production-ready TLS/SSL toolkit for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./ffi.alya"
import "./io/raw.alya"
import "./core/version.alya"
import "./core/cipher.alya"
import "./core/protect.alya"
import "./core/record.alya"
import "./core/handshake.alya"
import "./core/keys.alya"
import "./core/ecdhe.alya"
import "./cert/pem.alya"
import "./cert/x509.alya"
import "./cert/verify.alya"
import "./cert/ocsp.alya"
import "./cert/crl.alya"
import "./client/client.alya"
import "./client/rsa_handshake.alya"
@cfg(feature = "server")
import "./server/server.alya"
@cfg(feature = "ticket")
import "./session/ticket.alya"

# ═══════════════════════════════════════════════════════════════
# High-Level Idiomatic TLS API
# ═══════════════════════════════════════════════════════════════

## Creates a secure-by-default client configuration.
##
## Enforces TLS 1.2 minimum and required peer verification.
pub function config(host: string, port: int = 443) -> TlsConfig
    return tls_config_new(host, port, TlsVerifyMode.Required)
end

## Creates a development configuration without peer verification.
##
## Never use in production: hostname and chain checks are skipped.
pub function insecure_config(host: string, port: int = 443) -> TlsConfig
    return tls_config_new(host, port, TlsVerifyMode.None)
end

## Opens a TLS-negotiated connection to the configured endpoint.
pub function connect(cfg: TlsConfig) -> TlsContext
    return tls_connect(cfg)
end

## Closes a connection context.
pub function close(ctx: TlsContext) -> int
    return tls_close(ctx)
end

## Creates a TLS server listener.
##
## Requires the `server` feature (default-on).
@cfg(feature = "server")
pub function server(port: int = 8443, host: string = "0.0.0.0") -> TlsServer
    return tls_server_new(port, host)
end

## Returns the package version string.
pub function version() -> string
    return "0.1.0"
end

## Returns the native engine version code helper (FFI smoke check).
pub function native_version_code(major: int = 3, minor: int = 3) -> int
    return alya_tls_version_code(major, minor)
end

## Compares two strings in constant time via the native engine.
pub function secure_compare(a: string, b: string) -> int
    if a is null or b is null
        return 0
    end
    return alya_tls_const_eq(a, b)
end

## Formats a negotiated session as a one-line summary.
pub function session_summary(sess: TlsSession) -> string
    return f"{version_to_string(sess.version)} / {cipher_suite_name(sess.cipher_suite)} / sni={sess.sni}"
end

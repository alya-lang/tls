## TLS client: TCP dial, hello exchange, and secure tunnel helpers.
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## `tls_connect` performs a real TCP dial plus a best-effort ClientHello /
## ServerHello exchange for version and suite negotiation. Bulk encryption
## uses `core/keys.alya` material with `crypto` AEAD primitives; certificate
## authorization stays with `cert/verify.alya` on caller-supplied chains.

import "std/net" as net
import "../types.alya"
import "../core/version.alya"
import "../core/cipher.alya"
import "../core/record.alya"
import "../core/handshake.alya"
import "../cert/verify.alya"
import "../cert/x509.alya"
import "../cert/ocsp.alya"
import "../io/raw.alya"

## Builds a client configuration alias with secure defaults.
##
## ### Parameters
## - `host`: Remote hostname for SNI and verification.
## - `port`: Remote TCP port. Defaults to `443`.
## - `verify_mode`: Verification strictness. Defaults to `Required`.
##
## ### Returns
## Initialized `TlsConfig` instance.
pub function tls_client_config(host: string, port: int = 443, verify_mode: int = TlsVerifyMode.Required) -> TlsConfig
    return tls_config_new(host, port, verify_mode)
end

## Opens a TCP connection and negotiates TLS parameters.
##
## Never throws: every failure returns a `Failed` context carrying
## `last_error`. When the peer speaks no TLS, the context reports the
## parse failure while keeping the socket open for inspection.
##
## ### Parameters
## - `config`: Active `TlsConfig` snapshot.
##
## ### Returns
## Connected `TlsContext` (established or failed).
pub function tls_connect(config: TlsConfig) -> TlsContext
    let ctx = tls_context_new(config)
    if config.is_valid() == 0
        return ctx.fail("invalid TLS config (host, port, or version bounds)")
    end
    let sock = -1
    try
        sock = net::tcp_connect(config.host, config.port)
    catch e
        return ctx.fail("TCP connection failed to {config.host}:{config.port}")
    end
    if sock < 0
        return ctx.fail("TCP connection failed to {config.host}:{config.port}")
    end
    net::tcp_set_timeout(sock, config.timeout_ms)
    ctx.sock = sock
    ctx.state = TlsState.TcpConnected
    let hello = build_client_hello(config)
    let sent = raw_send(sock, hello["bytes"])
    if sent < 0
        return ctx.fail("failed to send ClientHello")
    end
    ctx.state = TlsState.HandshakeStarted
    let raw = []
    let tries = 0
    while tries < 8
        let st = raw_recv_status(sock, 4096)
        if st["closed"] == 1
            break
        end
        let chunk = st["data"]
        let c = 0
        while c < len(chunk)
            raw.push(chunk[c])
            c += 1
        end
        if len(raw) >= 5
            break
        end
        tries += 1
    end
    if len(raw) < 5
        return ctx.fail("no ServerHello received (peer may not speak TLS)")
    end
    let rec = record_decode(raw)
    if rec["error"] != ""
        return ctx.fail("ServerHello record error: " + rec["error"])
    end
    if rec["type"] == TlsContentType.Alert
        return ctx.fail("peer returned TLS alert during handshake")
    end
    if rec["type"] != TlsContentType.Handshake or len(rec["fragment"]) < 4
        return ctx.fail("unexpected TLS record during handshake")
    end
    let frag = rec["fragment"]
    if frag[0] != TlsHandshakeType.ServerHello
        return ctx.fail("expected ServerHello, got handshake type " + str(frag[0]))
    end
    let body = []
    let b = 4
    while b < len(frag)
        body.push(frag[b])
        b += 1
    end
    let sh = parse_server_hello(body)
    if sh["error"] != ""
        return ctx.fail("ServerHello parse error: " + sh["error"])
    end
    let negotiated = version_negotiate(config.min_version, config.max_version, sh["version"])
    if negotiated == 0
        return ctx.fail("no overlapping TLS version with peer")
    end
    if cipher_strength(sh["cipher_suite"]) == 0
        return ctx.fail("peer selected unknown cipher suite")
    end
    ctx.session.version = negotiated
    ctx.session.cipher_suite = sh["cipher_suite"]
    ctx.session.id_hex = sh["session_id"]
    ctx.session.state = TlsState.Handshaked
    ctx.session.created_ms = clock_ms()
    ctx.state = TlsState.Handshaked
    ctx.keys["client_random"] = hello["random"]
    ctx.keys["server_random"] = sh["random"]
    ctx.keys["transcript"] = pending_slice(hello["bytes"], 5, len(hello["bytes"]) - 5)
    ctx.keys["transcript"] = tls_transcript_append(ctx.keys["transcript"], TlsHandshakeType.ServerHello, body)
    let leftover = pending_slice(raw, rec["consumed"], len(raw) - rec["consumed"])
    return tls_read_peer_chain(ctx, leftover)
end

## Reads the peer Certificate message and enforces verification policy.
##
## Continues the handshake read loop after ServerHello, reassembling
## handshake fragments across records until a Certificate message arrives
## or the peer stops talking. A received leaf is verified through
## `tls_verify_session`, so `Required` mode fails closed without further
## caller action. Time checks are skipped (no wall-clock source); pass a
## stamp to `tls_verify_session` manually for full validity windows.
##
## ### Parameters
## - `ctx`: Handshaked `TlsContext` (mutated: chain stored, may fail).
## - `leading`: Already-read trailing bytes from the ServerHello read.
##
## ### Returns
## The same context, verified or failed.
pub function tls_read_peer_chain(ctx: TlsContext, leading = null) -> TlsContext
    let pending = []
    if leading is not null
        pending = leading
    end
    let stream = []
    let msg_type = -1
    let msg_need = -1
    let msg_buf = []
    let cert_body = []
    let cert_found = 0
    let ocsp_body = []
    let ocsp_found = 0
    let ske_body = []
    let ske_found = 0
    let done_seen = 0
    let rounds = 0
    while rounds < 17
        let pending_before = len(pending)
        let progress = 1
        while progress == 1 and len(pending) >= 5
            progress = 0
            let rec = record_decode(pending)
            if rec["error"] != ""
                break
            end
            pending = pending_slice(pending, rec["consumed"], len(pending) - rec["consumed"])
            progress = 1
            if rec["type"] == TlsContentType.Alert
                return ctx.fail("peer returned TLS alert during handshake")
            end
            if rec["type"] != TlsContentType.Handshake
                break
            end
            let f = 0
            while f < len(rec["fragment"])
                stream.push(rec["fragment"][f])
                f += 1
            end
            while msg_need == -1 and len(stream) >= 4
                msg_type = stream[0]
                msg_need = stream[1] * 65536 + stream[2] * 256 + stream[3]
                stream = pending_slice(stream, 4, len(stream) - 4)
            end
            while msg_need >= 0 and len(stream) > 0 and len(msg_buf) < msg_need
                msg_buf.push(stream[0])
                stream = pending_slice(stream, 1, len(stream) - 1)
            end
            if msg_need >= 0 and len(msg_buf) >= msg_need
                break
            end
        end
        if msg_need >= 0 and len(msg_buf) >= msg_need
            ctx.keys["transcript"] = tls_transcript_append(ctx.keys["transcript"], msg_type, msg_buf)
            if msg_type == TlsHandshakeType.Certificate
                cert_body = msg_buf
                cert_found = 1
            end
            if msg_type == TlsHandshakeType.ServerKeyExchange
                ske_body = msg_buf
                ske_found = 1
            end
            if msg_type == TlsHandshakeType.CertificateStatus
                ocsp_body = msg_buf
                ocsp_found = 1
            end
            if msg_type == TlsHandshakeType.ServerHelloDone
                done_seen = 1
            end
            msg_type = -1
            msg_need = -1
            msg_buf = []
        end
        if cert_found == 1 and done_seen == 1
            break
        end
        if len(pending) >= 5 and len(pending) < pending_before
            continue
        end
        if rounds >= 16
            break
        end
        let st = raw_recv_status(ctx.sock, 4096)
        if st["closed"] == 1
            break
        end
        let chunk = st["data"]
        let c = 0
        while c < len(chunk)
            pending.push(chunk[c])
            c += 1
        end
        rounds += 1
    end
    if cert_found == 1 and len(cert_body) > 0
        if done_seen == 0
            return ctx.fail("ServerHelloDone missing from handshake")
        end
        let chain = parse_certificate_chain(cert_body)
        ctx.session.peer_count = len(chain)
        if len(chain) == 0
            return ctx.fail("peer certificate message was empty")
        end
        ctx.keys["leaf_der"] = chain[0].der
        if len(chain) > 1
            ctx.keys["issuer_der"] = chain[1].der
        else
            ctx.keys["issuer_der"] = chain[0].der
        end
        if ske_found == 1
            ctx.keys["ske_body"] = ske_body
        end
        if ocsp_found == 1
            ctx.keys["ocsp_stapled"] = ocsp_body
        end
        tls_verify_session(ctx, chain[0], "", "")
        return ctx
    end
    if ctx.config.verify_mode == TlsVerifyMode.Required
        return ctx.fail("no certificate presented by peer")
    end
    return ctx
end

## Validates a stapled OCSP response captured during the handshake.
##
## No stapled message means no opinion (returns the context untouched).
## A present response must validate `good` against the leaf plus issuer
## pair, otherwise the context fails closed.
##
## ### Parameters
## - `ctx`: Handshaked `TlsContext` (mutated: may fail).
##
## ### Returns
## The same context, failed when the stapled status is not verified good.
pub function tls_check_stapled_ocsp(ctx: TlsContext) -> TlsContext
    let stapled = ctx.keys["ocsp_stapled"]
    if stapled is null or len(stapled) == 0
        return ctx
    end
    let cs = cert_status_parse_body(stapled)
    if cs["error"] != ""
        return ctx.fail("stapled OCSP response malformed")
    end
    let leaf = ctx.keys["leaf_der"]
    let issuer = ctx.keys["issuer_der"]
    if issuer is null or len(issuer) == 0
        issuer = leaf
    end
    let v = ocsp_validate_for_cert(cs["resp"], leaf, issuer, "")
    if v["status"] != "good" or v["verified"] == 0
        return ctx.fail("stapled OCSP rejected: " + v["detail"])
    end
    ctx.keys["ocsp_status"] = v["status"]
    return ctx
end

## Appends one handshake message (header + body) to a transcript
pub function tls_transcript_append(transcript, msg_type: int, body) -> array
    let out = transcript
    if out is null
        out = []
    end
    out.push(msg_type)
    out.push(bit_and(bit_shr(len(body), 16), 255))
    out.push(bit_and(bit_shr(len(body), 8), 255))
    out.push(bit_and(len(body), 255))
    let i = 0
    while i < len(body)
        out.push(body[i])
        i += 1
    end
    return out
end

# Copies a byte window from an array.
function pending_slice(data, offset: int, n: int) -> array
    let part = []
    if data is null or n <= 0
        return part
    end
    let i = 0
    while i < n and offset + i < len(data)
        part.push(data[offset + i])
        i += 1
    end
    return part
end

## Establishes an offline session for framing and policy tests.
##
## Performs no I/O. Useful for record protection and verification flows
## without a live peer.
##
## ### Parameters
## - `config`: Active `TlsConfig` snapshot.
## - `version`: Negotiated version code. Defaults to TLS 1.2.
## - `suite`: Negotiated suite id. Defaults to AES-128-GCM.
##
## ### Returns
## `Established` context with `sock = -1`.
pub function tls_mock_establish(config: TlsConfig, version: int = TlsVersion.Tls12, suite: int = SUITE_AES_128_GCM_SHA256) -> TlsContext
    let ctx = tls_context_new(config)
    ctx.session.version = version
    ctx.session.cipher_suite = suite
    ctx.session.state = TlsState.Established
    ctx.session.created_ms = clock_ms()
    ctx.state = TlsState.Established
    return ctx
end

## Sends text over the established tunnel (TEXT-SAFE ONLY).
##
## Payloads with NUL bytes are truncated by the string layer; use
## `tls_send_data` for binary records.
##
## ### Parameters
## - `ctx`: Active `TlsContext`.
## - `data`: Payload string.
##
## ### Returns
## Bytes sent, or -1 when the socket is unusable.
pub function tls_send(ctx: TlsContext, data: string) -> int
    if ctx is null or ctx.sock < 0
        return -1
    end
    if data is null
        data = ""
    end
    return net::tcp_send(ctx.sock, data)
end

## Sends binary data over the tunnel (NUL-safe).
##
## ### Parameters
## - `ctx`: Active `TlsContext`.
## - `data`: Payload byte array.
##
## ### Returns
## Bytes sent, or -1 when the socket is unusable.
pub function tls_send_data(ctx: TlsContext, data) -> int
    if ctx is null or ctx.sock < 0
        return -1
    end
    return raw_send(ctx.sock, data)
end

## Receives text from the tunnel (TEXT-SAFE ONLY).
##
## ### Parameters
## - `ctx`: Active `TlsContext`.
## - `max_bytes`: Read limit. Defaults to `4096`.
##
## ### Returns
## Received string, or empty on close/error.
pub function tls_recv(ctx: TlsContext, max_bytes: int = 4096) -> string
    if ctx is null or ctx.sock < 0
        return ""
    end
    let limit = max_bytes
    if limit <= 0
        limit = 4096
    end
    return net::tcp_recv(ctx.sock, limit)
end

## Receives binary data from the tunnel (NUL-safe).
##
## ### Parameters
## - `ctx`: Active `TlsContext`.
## - `max_bytes`: Read limit. Defaults to `4096`.
##
## ### Returns
## Byte array (empty on close/error).
pub function tls_recv_data(ctx: TlsContext, max_bytes: int = 4096) -> array
    if ctx is null or ctx.sock < 0
        return []
    end
    return raw_recv(ctx.sock, max_bytes)
end

## Frames plaintext as ApplicationData records for an established session.
##
## Returns binary record arrays (not strings) because record headers
## routinely contain NUL bytes. Send each element with `tls_send_data`.
##
## ### Parameters
## - `ctx`: Established `TlsContext`.
## - `plaintext`: Payload byte array.
##
## ### Returns
## Array of record byte arrays ready for `tls_send_data`.
pub function tls_wrap_app_data(ctx: TlsContext, plaintext) -> array
    let out = []
    if ctx is null or ctx.session.is_established() == 0
        return out
    end
    let data = plaintext
    if data is null
        data = []
    end
    let parts = record_fragment(data)
    let i = 0
    while i < len(parts)
        let rec = record_encode(TlsContentType.ApplicationData, ctx.session.version, parts[i])
        out.push(rec["bytes"])
        i += 1
    end
    return out
end

## Verifies a peer certificate against the context policy and records it.
##
## Call after the handshake with the peer-supplied chain (current scope:
## caller-supplied certificates; automatic `Certificate`-message parsing
## is a tracked future). `Required` mode fails the context on any check
## failure; `Optional` reports advisory verdicts without failing.
##
## ### Parameters
## - `ctx`: Active `TlsContext` (mutated: fingerprint stored, may fail).
## - `cert`: Parsed peer certificate (or null when none presented).
## - `now_stamp`: Reference stamp (`""` skips the time check).
## - `pinned_fp`: Optional pinned fingerprint (`""` disables).
##
## ### Returns
## Verdict map with `ok`, `host_ok`, `time_ok`, `pin_ok`, `detail`.
pub function tls_verify_session(ctx: TlsContext, cert, now_stamp: string = "", pinned_fp: string = "") -> map
    let mode = TlsVerifyMode.Required
    if ctx is not null
        mode = ctx.config.verify_mode
    end
    if mode == TlsVerifyMode.None
        if cert is not null
            ctx.session.peer_fingerprint = cert.fingerprint_sha256
        end
        return { "ok": 1, "host_ok": 1, "time_ok": 1, "pin_ok": 1, "detail": "verification disabled" }
    end
    if cert is null or ctx is null
        if ctx is not null
            ctx.fail("no peer certificate presented")
        end
        return { "ok": 0, "host_ok": 0, "time_ok": 0, "pin_ok": 1, "detail": "no peer certificate presented" }
    end
    let hostname = ctx.config.host
    if ctx.session.sni is not null and ctx.session.sni != ""
        hostname = ctx.session.sni
    end
    let verdict = verify_peer(cert, hostname, mode, now_stamp, pinned_fp)
    ctx.session.peer_fingerprint = cert.fingerprint_sha256
    if mode == TlsVerifyMode.Required and verdict["ok"] == 0
        ctx.fail(verdict["detail"])
    end
    return verdict
end

## Closes the tunnel socket and marks the context closed.
##
## Sends a `close_notify` warning alert first (best effort, RFC 8446
## section 6.1) so peers distinguish clean shutdown from truncation.
##
## ### Parameters
## - `ctx`: Target `TlsContext` (mutated in place).
##
## ### Returns
## `0` on success.
pub function tls_close(ctx: TlsContext) -> int
    if ctx is not null
        if ctx.sock >= 0
            let ver = ctx.session.version
            if version_is_supported(ver) == 0
                ver = TlsVersion.Tls12
            end
            raw_send(ctx.sock, tls_alert_bytes(TlsAlertLevel.Warning, TlsAlertDescription.CloseNotify, ver))
            net::tcp_close(ctx.sock)
            ctx.sock = -1
        end
        ctx.state = TlsState.Closed
    end
    return 0
end

## Builds a plaintext HTTP request for an established tunnel.
##
## ### Parameters
## - `host`: Authority hostname.
## - `path`: Request target. Defaults to `"/"`.
##
## ### Returns
## HTTP/1.1 GET wire string with Host and Connection headers.
pub function https_request_wire(host: string, path: string = "/") -> string
    let target = path
    if target is null or target == ""
        target = "/"
    end
    return "GET " + target + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: Alya-Tls/0.1.0\r\nConnection: close\r\n\r\n"
end

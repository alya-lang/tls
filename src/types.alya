## tls Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines TLS protocol versions, content types, handshake roles, certificate
## models, session state, and connection contexts shared by every submodule.

# ───────────────────────────────────────────────────────────────
# Protocol Enumerations
# ───────────────────────────────────────────────────────────────

## TLS protocol version codes (wire value major/minor combined).
##
## Values match the on-wire `ProtocolVersion` (e.g. TLS 1.2 = 0x0303).
pub enum TlsVersion
    Tls10 = 769,
    Tls11 = 770,
    Tls12 = 771,
    Tls13 = 772
end

## TLS record layer content types (RFC 8446 section 5.1).
pub enum TlsContentType
    ChangeCipherSpec = 20,
    Alert = 21,
    Handshake = 22,
    ApplicationData = 23
end

## TLS handshake message types (RFC 8446 section 4).
pub enum TlsHandshakeType
    ClientHello = 1,
    ServerHello = 2,
    Certificate = 11,
    ServerKeyExchange = 12,
    ServerHelloDone = 14,
    ClientKeyExchange = 16,
    CertificateStatus = 22,
    Finished = 20
end

## TLS alert severity levels.
pub enum TlsAlertLevel
    Warning = 1,
    Fatal = 2
end

## Common TLS alert descriptions.
pub enum TlsAlertDescription
    CloseNotify = 0,
    UnexpectedMessage = 10,
    BadRecordMac = 20,
    HandshakeFailure = 40,
    BadCertificate = 42,
    CertificateExpired = 45,
    UnknownCa = 48,
    InternalError = 80
end

## Peer certificate verification strictness.
##
## - `None`: accept any peer without verification (testing only).
## - `Optional`: verify when a certificate is presented.
## - `Required`: fail the handshake without a valid chain.
pub enum TlsVerifyMode
    None = 0,
    Optional = 1,
    Required = 2
end

## Connection lifecycle states.
pub enum TlsState
    Closed = 0,
    TcpConnected = 1,
    HandshakeStarted = 2,
    Handshaked = 3,
    Established = 4,
    Failed = 5
end

## Endpoint role in the handshake.
pub enum TlsRole
    Client = 0,
    Server = 1
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Client/server configuration for TLS connections.
##
## ### Fields
## - `host`: Remote hostname or IP for SNI and verification.
## - `port`: Remote TCP port (443 for HTTPS).
## - `sni`: Server Name Indication value (defaults to `host`).
## - `alpn`: Negotiated application protocols (e.g. `["h2", "http/1.1"]`).
## - `verify_mode`: Peer verification strictness (`TlsVerifyMode`).
## - `min_version`: Lowest acceptable version (`TlsVersion` code).
## - `max_version`: Highest acceptable version (`TlsVersion` code).
## - `timeout_ms`: TCP and handshake timeout in milliseconds.
## - `ca_pem`: Trusted CA bundle in PEM format (or empty for OS default).
## - `cert_pem`: Local certificate chain in PEM format (server side).
## - `key_pem`: Local private key in PEM format (server side).
## - `cipher_allowlist`: Allowed cipher suite ids (empty means defaults).
pub struct TlsConfig
    host: string,
    port: int,
    sni: string,
    alpn: array,
    verify_mode: int,
    min_version: int,
    max_version: int,
    timeout_ms: int,
    ca_pem: string,
    cert_pem: string,
    key_pem: string,
    cipher_allowlist: array
end

## Parsed peer certificate summary.
##
## Produced by the minimal X.509 scanner in `cert/x509.alya`. Stores the
## fields required for hostname, time, and fingerprint-pin verification.
##
## ### Fields
## - `subject`: Full subject distinguished name string.
## - `issuer`: Full issuer distinguished name string.
## - `subject_cn`: Subject common name (OID 2.5.4.3).
## - `issuer_cn`: Issuer common name.
## - `san`: Subject Alternative Name DNS entries array.
## - `serial_hex`: Certificate serial number as lowercase hex.
## - `not_before`: Validity start (`YYYYMMDDHHMMSSZ` normalized).
## - `not_after`: Validity end (`YYYYMMDDHHMMSSZ` normalized).
## - `fingerprint_sha256`: Lowercase hex SHA-256 over DER bytes.
## - `der_len`: Raw DER byte length.
## - `der`: Raw DER bytes (kept for signature verification).
pub struct TlsCertificate
    subject: string,
    issuer: string,
    subject_cn: string,
    issuer_cn: string,
    san: array,
    serial_hex: string,
    not_before: string,
    not_after: string,
    fingerprint_sha256: string,
    der_len: int,
    der: array
end

## Negotiated session parameters.
##
## ### Fields
## - `id_hex`: Session identifier as lowercase hex (may be empty).
## - `version`: Negotiated version code (`TlsVersion`).
## - `cipher_suite`: Negotiated cipher suite id.
## - `sni`: Server name used during negotiation.
## - `alpn`: Protocol selected by the server (or empty).
## - `state`: Session state (`TlsState`).
## - `peer_fingerprint`: Leaf certificate SHA-256 fingerprint (or empty).
## - `peer_count`: Certificates seen in the peer chain (0 when unread).
## - `created_ms`: Session creation timestamp (`clock_ms()`).
pub struct TlsSession
    id_hex: string,
    version: int,
    cipher_suite: int,
    sni: string,
    alpn: string,
    state: int,
    peer_fingerprint: string,
    peer_count: int,
    created_ms: int
end

## Live connection context binding config, session, and socket.
##
## ### Fields
## - `config`: Active `TlsConfig` snapshot.
## - `session`: Current `TlsSession` snapshot.
## - `sock`: Underlying TCP socket handle (-1 when closed).
## - `state`: Connection state (`TlsState`).
## - `last_error`: Human-readable failure reason (empty on success).
## - `keys`: Handshake working map (transcript, randoms, leaf, traffic keys).
## - `role`: Endpoint role (`TlsRole` Client or Server, default Client).
pub struct TlsContext
    config,
    session,
    sock: int,
    state: int,
    last_error: string,
    keys: map,
    role: int
end

# ───────────────────────────────────────────────────────────────
# Factory Constructors
# ───────────────────────────────────────────────────────────────

## Builds a validated client configuration with secure defaults.
##
## Defaults enforce TLS 1.2 minimum, 10s timeout, and required peer
## verification. Pass `TlsVerifyMode.None` explicitly for local testing.
##
## ### Parameters
## - `host`: Remote hostname used for SNI and verification.
## - `port`: Remote TCP port. Defaults to `443`.
## - `verify_mode`: Verification strictness. Defaults to `Required`.
##
## ### Returns
## A fully initialized `TlsConfig` instance.
pub function tls_config_new(host: string, port: int = 443, verify_mode: int = TlsVerifyMode.Required) -> TlsConfig
    let h = host
    if h is null or h == ""
        h = "localhost"
    end
    let p = port
    if p <= 0
        p = 443
    end
    return TlsConfig {
        host: h,
        port: p,
        sni: h,
        alpn: ["h2", "http/1.1"],
        verify_mode: verify_mode,
        min_version: TlsVersion.Tls12,
        max_version: TlsVersion.Tls13,
        timeout_ms: 10000,
        ca_pem: "",
        cert_pem: "",
        key_pem: "",
        cipher_allowlist: []
    }
end

## Builds an empty certificate placeholder (no fields parsed).
##
## ### Returns
## A zero-value `TlsCertificate` with empty strings and arrays.
pub function tls_cert_empty() -> TlsCertificate
    return TlsCertificate {
        subject: "",
        issuer: "",
        subject_cn: "",
        issuer_cn: "",
        san: [],
        serial_hex: "",
        not_before: "",
        not_after: "",
        fingerprint_sha256: "",
        der_len: 0,
        der: []
    }
end

## Builds a new session in the `Closed` state.
##
## ### Parameters
## - `sni`: Server name tied to this session. Defaults to `""`.
##
## ### Returns
## A fresh `TlsSession` with version 0 and empty negotiation results.
pub function tls_session_new(sni: string = "") -> TlsSession
    let name = sni
    if name is null
        name = ""
    end
    return TlsSession {
        id_hex: "",
        version: 0,
        cipher_suite: 0,
        sni: name,
        alpn: "",
        state: TlsState.Closed,
        peer_fingerprint: "",
        peer_count: 0,
        created_ms: clock_ms()
    }
end

## Wraps a config and session into a fresh disconnected context.
##
## ### Parameters
## - `config`: Active `TlsConfig` snapshot.
## - `session`: Current `TlsSession` snapshot (or null for a new one).
##
## ### Returns
## A `TlsContext` with `sock = -1` and state `Closed`.
pub function tls_context_new(config, session = null) -> TlsContext
    let sess = session
    if sess is null
        sess = tls_session_new(config.sni)
    end
    return TlsContext {
        config: config,
        session: sess,
        sock: -1,
        state: TlsState.Closed,
        last_error: "",
        keys: {},
        role: TlsRole.Client
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: TlsConfig
# ───────────────────────────────────────────────────────────────

## Returns 1 when host/port and version bounds are coherent.
##
## ### Parameters
## - `self`: The target `TlsConfig` instance.
##
## ### Returns
## `1` when valid, `0` otherwise.
pub function TlsConfig.is_valid(self: TlsConfig) -> int
    if self.host is null or self.host == ""
        return false
    end
    if self.port <= 0 or self.port > 65535
        return false
    end
    if self.min_version > self.max_version
        return false
    end
    if self.timeout_ms <= 0
        return false
    end
    return true
end

## Returns an immutable copy bound to a different host (SNI follows).
##
## ### Parameters
## - `self`: The current `TlsConfig` instance.
## - `new_host`: Replacement hostname string.
##
## ### Returns
## A new `TlsConfig` with updated `host` and `sni`.
pub function TlsConfig.with_host(self: TlsConfig, new_host: string) -> TlsConfig
    let h = new_host
    if h is null or h == ""
        h = self.host
    end
    return TlsConfig {
        host: h,
        port: self.port,
        sni: h,
        alpn: self.alpn,
        verify_mode: self.verify_mode,
        min_version: self.min_version,
        max_version: self.max_version,
        timeout_ms: self.timeout_ms,
        ca_pem: self.ca_pem,
        cert_pem: self.cert_pem,
        key_pem: self.key_pem,
        cipher_allowlist: self.cipher_allowlist
    }
end

## Returns an immutable copy with a different verification mode.
##
## ### Parameters
## - `self`: The current `TlsConfig` instance.
## - `mode`: New `TlsVerifyMode` value.
##
## ### Returns
## A new `TlsConfig` with updated `verify_mode`.
pub function TlsConfig.with_verify(self: TlsConfig, mode: int) -> TlsConfig
    return TlsConfig {
        host: self.host,
        port: self.port,
        sni: self.sni,
        alpn: self.alpn,
        verify_mode: mode,
        min_version: self.min_version,
        max_version: self.max_version,
        timeout_ms: self.timeout_ms,
        ca_pem: self.ca_pem,
        cert_pem: self.cert_pem,
        key_pem: self.key_pem,
        cipher_allowlist: self.cipher_allowlist
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: TlsSession
# ───────────────────────────────────────────────────────────────

## Returns 1 when the session completed negotiation.
##
## ### Parameters
## - `self`: The target `TlsSession` instance.
##
## ### Returns
## `1` for `Established`/`Handshaked` states with a version set.
pub function TlsSession.is_established(self: TlsSession) -> int
    if self.version == 0
        return false
    end
    if self.state == TlsState.Established or self.state == TlsState.Handshaked
        return true
    end
    return false
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: TlsContext
# ───────────────────────────────────────────────────────────────

## Returns 1 when the context holds no recorded error.
##
## ### Parameters
## - `self`: The target `TlsContext` instance.
##
## ### Returns
## `1` when `last_error` is empty, `0` otherwise.
pub function TlsContext.is_ok(self: TlsContext) -> int
    if self.last_error is null or self.last_error == ""
        return true
    end
    return false
end

## Records a failure reason and moves the context to `Failed`.
##
## ### Parameters
## - `self`: The target `TlsContext` instance (mutated in place).
## - `reason`: Human-readable failure description.
##
## ### Returns
## The same context for chaining.
pub function TlsContext.fail(self: TlsContext, reason: string) -> TlsContext
    self.state = TlsState.Failed
    self.last_error = reason
    return self
end
